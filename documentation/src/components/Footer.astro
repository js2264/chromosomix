---
/**
 * Starlight's footer — the edit link and the previous and next pages — and a
 * line saying which build of the documentation this is; and, on every page,
 * the script that turns a live picture into the app (`LiveViews.astro`).
 */
import Default from '@astrojs/starlight/components/Footer.astro'
import { COMMIT, IS_DEV, PREVIEW, PREVIEW_URL, REPOSITORY, VERSION } from '../lib/site.mjs'
import LiveViews from './LiveViews.astro'
---

<Default />
<LiveViews />
<p class="cx-build">
  {PREVIEW !== null
    ? `Documentation of chromosomix, a preview of pull request #${PREVIEW}`
    : IS_DEV
      ? 'Documentation of chromosomix, unreleased'
      : `Documentation of chromosomix ${VERSION}`}
  {COMMIT !== '' && (
    <>
      {' · built from '}
      <a href={`${REPOSITORY}/commit/${COMMIT}`}>{COMMIT}</a>
    </>
  )}
  {' · '}
  <a href={PREVIEW_URL === null ? `${REPOSITORY}/tree/main/documentation` : `${PREVIEW_URL}/files`}>source</a>
</p>
