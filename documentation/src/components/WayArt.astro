  .frame {
    fill: var(--cx-bg-raised);
    stroke: var(--cx-border-strong);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .well {
    fill: var(--cx-bg-sunken);
    stroke: var(--cx-border);
    stroke-width: 0.8;
  }
  .inset {
    fill: var(--cx-bg);
    stroke: var(--cx-accent);
    stroke-width: 1.4;
  }
  .rule {
    stroke: var(--cx-border-strong);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .dot {
    fill: var(--cx-border-strong);
  }
  .gene {
    fill: var(--cx-text-faint);
  }
  .signal {
    fill: none;
    stroke: var(--cx-accent);
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .label {
    font: 500 6px var(--cx-sans);
    fill: var(--cx-text-faint);
  }
  .label.small {
    font-size: 5.2px;
  }
  .label.mono {
    font-family: var(--cx-mono);
    font-size: 5.6px;
  }
  .label.strong {
    font-weight: 650;
    fill: var(--cx-text);
  }
  .label.on-accent {
    font-weight: 650;
    fill: var(--cx-on-accent);
  }
  .badge,
  .tag {
    fill: var(--cx-accent);
  }
  .tagline {
    fill: var(--cx-accent-soft);
  }
  .badge-mark,
  .arrow {
    fill: none;
    stroke: var(--cx-on-accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .arrow {
    stroke: var(--cx-accent);
  }
  .hole {
    fill: var(--cx-bg-raised);
  }
  .fold {
    fill: none;
    stroke: var(--cx-border-strong);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .faint {
    fill: none;
    stroke: var(--cx-text-faint);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .cross {
    stroke: var(--cx-danger);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .accent-dot {
    fill: var(--cx-ok);
  }
  .terminal {
    fill: #17181a;
    stroke: var(--cx-border-strong);
    stroke-width: 1.2;
  }
  .term-dot {
    fill: #54565a;
  }
  .term-text,
  .term-faint {
    font: 500 6.2px var(--cx-mono);
    fill: #eeeff1;
  }
  .term-faint {
    fill: #8a8c90;
  }
  .accent-text {
    fill: #6ba4e8;
  }
</style>
