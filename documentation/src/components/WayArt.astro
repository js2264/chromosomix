---
/**
 * The illustration of one way to use chromosomix, for the page that lists them
 * (`start/ways.mdx`): a line drawing in the app's own tokens, so it is
 * drawn for the theme it is shown in, around the one motif every way shares —
 * a contact map, its cells warmest along the diagonal, as the app draws one.
 */
interface Props {
  kind: 'web' | 'installed' | 'desktop' | 'file' | 'pinned' | 'self' | 'embed' | 'notebook' | 'cli'
}
const { kind } = Astro.props

/** The map's colours by distance from the diagonal, as the default colour map runs from dark red to pale. */
const HEAT = ['#9e1b10', '#d9481f', '#ef7d32', '#f6b55a', '#fbdc93', '#fdf0cf']

/** A small contact map: `n` × `n` cells at (`x`, `y`), `size` wide. */
function map(x: number, y: number, size: number, n = 6) {
  const cell = size / n
  const cells = []
  for (let i = 0; i < n; i++) {
    for (let j = 0; j < n; j++) {
      cells.push({ x: x + j * cell, y: y + i * cell, w: cell + 0.2, fill: HEAT[Math.min(Math.abs(i - j), HEAT.length - 1)] })
    }
  }
  return cells
}

/** A track's line under a map: a few bumps, like a coverage profile. */
function track(x: number, y: number, width: number, height: number): string {
  const steps = 16
  const points = []
  for (let k = 0; k <= steps; k++) {
    const t = k / steps
    const bump = Math.max(0, Math.sin(t * Math.PI * 5.2 + 0.6)) ** 2 * (0.45 + 0.55 * Math.abs(Math.sin(t * 7.1)))
    points.push(`${(x + t * width).toFixed(1)},${(y + height - bump * height).toFixed(1)}`)
  }
  return points.join(' ')
}
