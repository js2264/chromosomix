<?xml version="1.0" encoding="UTF-8"?>
<!--
  Entitlements for a *signed* macOS build, referenced only from the commented
  block in `electron-builder.config.cjs`. Nothing reads this file today.

  It exists now rather than later because both keys are non-obvious and both
  produce the same symptom — an app that launches and then fails the first time
  it opens a file, which is a long way from anything about signing:

  - `allow-jit` is what lets V8 and, more to the point, the wasm engine map
    executable pages. Under a hardened runtime without it, h5wasm fails to
    instantiate.
  - `disable-library-validation` is what lets Electron's framework load
    libraries not signed by the same team.

  No network entitlements: the app is not sandboxed by the App Sandbox, and
  these are the hardened-runtime keys only.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
