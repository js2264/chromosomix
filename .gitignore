node_modules/
dist/
.vite/
# The archived copy of one commit (`npm run build:pinned`). Built in CI, copied
# into the published site under v/<commit>/, and never committed here — the
# archive lives on its own branch, written by scripts/archive-versions.mjs.
dist-pinned/
# Where that branch is checked out during a deploy, beside the build it is
# about to receive. Only ever present on a runner, but a stray local run of the
# workflow's steps must not offer to commit a copy of it into main.
archive/
# The desktop build's two outputs, and the archive it packs. `build/` is
# deliberately absent: that is electron-builder's `buildResources` input, and
# ignoring it would drop the icon and the entitlements out of the repository.
dist-electron/
release/
*.asar
*.log
.DS_Store
__pycache__/

# The icon size ladder `npm run icons:app` draws alongside the five icons the
# app actually installs. Those five are committed (see the script's docstring);
# this is the by-hand overflow — both variants at every size — and nothing in
# the build reads it.
out/

# Fixtures and goldens are generated (`npm run fixtures`); the large real-world
# datasets in data/ are never committed.
test/fixtures/
data/*.metacool
data/*.mmetacool
data/*.cool
data/*.mcool
data/*.pairs.gz
data/*.txt
data/*.tsv

# Scratch checkouts an agent works in. A worktree is a checkout of *this*
# repository, so `git add -A` at the top level offers to commit it as an
# embedded repo — one gitlink pointing at a path that exists on one machine.
.claude/worktrees/
dist-cli/
dist-standalone/
