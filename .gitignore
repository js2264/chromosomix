node_modules/
# The same name without the slash, because a worktree links `node_modules` to
# the main checkout's rather than installing a second copy, and a symlink is
# not a directory as far as the pattern above is concerned.
node_modules
dist/
.vite/
# The archived copy of one commit (`npm run build:pinned`). Built in CI, copied
# into the published site under v/<commit>/, and never committed here — the
# archive lives on its own branch, written by scripts/archive-versions.mjs.
dist-pinned/
# Where that branch is checked out during a deploy, beside the build it is
# about to receive. Only ever present on a runner, but a stray local run of the
# workflow's steps must not offer to commit a copy of it into main.
archive/
# The desktop build's two outputs, and the archive it packs. `build/` is
# deliberately absent: that is electron-builder's `buildResources` input, and
# ignoring it would drop the icon and the entitlements out of the repository.
dist-electron/
release/
*.asar
*.log
.DS_Store
__pycache__/

# The icon size ladder `npm run icons:app` draws alongside the five icons the
# app actually installs. Those five are committed (see the script's docstring);
# this is the by-hand overflow — both variants at every size — and nothing in
# the build reads it.
out/

# Fixtures and goldens are generated (`npm run fixtures`); the large real-world
# datasets in data/ are never committed.
test/fixtures/
# Written beside its own fixture by `npm run fixtures:pairs`: committed alone it
# would turn its suite's skip-by-name into a failure on every fresh clone.
test/golden/pairs_cload.json
data/*.metacool
data/*.mmetacool
data/*.cool
data/*.mcool
data/*.pairs.gz
data/*.txt
data/*.fa
data/*.gtf
data/*.tsv
# Written by scripts/make-scrambled-demo.ts for the stage's gallery.
data/scrambled/

# Scratch checkouts an agent works in. A worktree is a checkout of *this*
# repository, so `git add -A` at the top level offers to commit it as an
# embedded repo — one gitlink pointing at a path that exists on one machine.
.claude/worktrees/
dist-cli/
dist-standalone/

# Screenshots from the UI galleries (`scripts/ui-gallery.mjs`, `scripts/ui-figures.mjs`).
# Written on demand, looked at, sent to the reader, and regenerated on the next
# change — a picture of one build is not something to keep in the repository.
gallery/
gallery-figures/
gallery-bacteria/
gallery-peaks/
gallery-csp/

# What notebooks/dbz-chromosome-figures.qmd fetches and makes: the store's maps
# and references, every output of the chromosomix command, the figures, and
# what Quarto renders — all regenerated by rendering it, and the maps alone are
# a hundred megabytes.
notebooks/work/
notebooks/figures/
notebooks/*.html
notebooks/*_files/
notebooks/.quarto/
# The notebook Quarto executes, written beside the .qmd for as long as a render runs.
notebooks/*.quarto_ipynb
